+    async function erroCadastro(response) {
+        if (response.status !== 400) return mensagem(response.status);
+        const text = await response.text();
+        const known = new Set(["CPF inválido. Confira o número informado.", "A senha deve ocupar no máximo 72 bytes.",
+            "Informe CRM-SP 1234567: UF e número de até 7 dígitos (sufixo -P se provisório).",
+            "Informe nome completo, UF e número de 1 a 7 dígitos, diferente de zero."]);
+        if (known.has(text.trim())) return text.trim();
+        try {
+            const {campos} = JSON.parse(text);
+            const labels = {nome: "Nome", email: "E-mail", senha: "Senha", cpf: "CPF", telefone: "Telefone",
+                cep: "CEP", estado: "Estado", cidade: "Cidade", bairro: "Bairro", logradouro: "Logradouro",
+                numero: "Número", formacao: "Formação", numRegistro: "Registro", codigoEmail: "Código de e-mail"};
+            const allowed = new Set(["Preencha este campo.", "O tamanho informado não é permitido.", "Confira este campo.",
+                "CPF deve possuir exatamente 11 dígitos.", "Telefone deve possuir 10 ou 11 dígitos.", "CEP deve possuir 8 dígitos.",
+                "A senha deve ter ao menos 8 caracteres, com maiúscula, minúscula, número e caractere especial."]);
+            const errors = Object.entries(labels).filter(([key]) => allowed.has(campos?.[key]))
+                .map(([key, label]) => `${label}: ${campos[key]}`);
+            return errors.join(" ") || mensagem(response.status);
+        } catch (_) { return mensagem(response.status); }
+    }
