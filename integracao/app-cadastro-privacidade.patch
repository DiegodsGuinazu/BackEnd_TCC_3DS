diff --git a/tests/cadastro-validacao.test.cjs b/tests/cadastro-validacao.test.cjs
new file mode 100644
index 0000000..8bc6fd7
--- /dev/null
+++ b/tests/cadastro-validacao.test.cjs
@@ -0,0 +1,28 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const vm = require('node:vm');
+const fs = require('node:fs');
+const path = require('node:path');
+const load = name => fs.readFileSync(path.join(__dirname, '../assets/js', name), 'utf8');
+const ctx = {window: {}};
+vm.runInNewContext(load('form-utils.js'), ctx);
+vm.runInNewContext(load('confirmacao-email.js').replace('Object.freeze({ cadastrar })', 'Object.freeze({ cadastrar, erroCadastro })'), ctx);
+const forms = ctx.window.EspectroCareForms;
+const errors = ctx.window.EspectroCareConfirmacaoEmail.erroCadastro;
+test('telefone digitado ou colado nunca excede 11 dígitos', () => {
+  let input;
+  const field = {value: '', addEventListener: (_, fn) => {input = fn;}};
+  forms.bindMaskedInput(field, forms.formatPhone, 11);
+  for(const value of ['11999999999999', '(11) 99999-9999', '11 99999-9999']) {
+    field.value = value; input();
+    assert.equal(field.value.replace(/\D/g, ''), '11999999999');
+  }
+});
+test('cadastro mostra erro de campo e preserva mensagens desconhecidas', async () => {
+  const response = text => ({status:400, text: async () => text});
+  const message = await errors(response(JSON.stringify({campos:{senha:'A senha deve ter ao menos 8 caracteres, com maiúscula, minúscula, número e caractere especial.'}})));
+  assert.match(message, /Senha:.*8 caracteres/);
+  assert.doesNotMatch(await errors(response(JSON.stringify({campos:{senha:'senha-secreta'}}))), /senha-secreta/);
+  assert.doesNotMatch(await errors(response('<html>stacktrace</html>')), /stacktrace/);
+  assert.match(await errors({status:422}), /Código inválido/);
+});
